PORT=3000
# Development uchun standart qiymat. Serverni ISHLAB CHIQARISHGA
# (production) chiqarganda buni albatta "production" ga o'zgartiring —
# aks holda cookie xavfsizlik sozlamalari (secure:true) ishlamaydi.
NODE_ENV=development
# XAVFSIZLIK: bu — faqat NAMUNA qiymat, HAQIQIY loyihada ishlatilmasin!
# Production'ga chiqarishdan oldin buni uzun, tasodifiy qatorga
# almashtiring, masalan quyidagi buyruq bilan yaratish mumkin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Agar bu o'zgartirilmagan holida NODE_ENV=production bilan ishga
# tushirilsa, server xavfsizlik uchun ATAYLAB ishga tushmaydi.
SESSION_SECRET=REPLACE_ME_with_a_long_random_string_before_deploying

# Push xabarnomalar (Web Push) uchun VAPID kalitlari.
# Generatsiya qilish: npx web-push generate-vapid-keys
# Ikkalasi ham to'ldirilmasa, sayt baribir ishlayveradi — faqat push
# xabarnomalar (masalan yangi xabar/buyurtma holati haqida) yuborilmaydi.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@madein.net

# Email (SMTP) — parolni tiklash xatlari va push mavjud bo'lmaganda
# zaxira bildirishnomalar (buyurtma holati, blok/cheklov) uchun kerak.
# To'ldirilmasa, sayt baribir ishlayveradi — faqat email yuborilmaydi,
# o'rniga tegishli amallar (masalan parolni tiklash) xatolik qaytaradi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Madein.net <no-reply@madein.net>
SITE_URL=http://localhost:3000

# To'lov tizimlari (ixtiyoriy) — O'zbekiston uchun Payme va Click.
# Ikkalasi ham to'ldirilmasa, checkout'da faqat "qo'lda/offline to'lov"
# (naqd yoki pul o'tkazma, sotuvchi bilan chatda kelishiladi) ko'rsatiladi.
#
# PAYME (https://business.payme.uz — "Kassa" bo'limidan oling):
#   PAYME_MERCHANT_ID — sizning Merchant ID'ingiz (kassa identifikatori)
#   PAYME_SECRET_KEY  — test yoki jonli kalit (Kassa sozlamalaridan)
#   PAYME_TEST_MODE   — true bo'lsa checkout.test.paycom.uz ishlatiladi
# Webhook URL Payme kabinetida quyidagicha ko'rsatiladi:
#   https://SIZNING_DOMENINGIZ/api/payments/payme
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=true

# CLICK (https://merchant.click.uz):
#   CLICK_SERVICE_ID, CLICK_MERCHANT_ID, CLICK_MERCHANT_USER_ID — Click
#     kabinetidagi "Merchant" bo'limidan
#   CLICK_SECRET_KEY — Click bilan tuzilgan shartnomada berilgan maxfiy kalit
# Webhook (Prepare/Complete) URL'lari Click kabinetida:
#   https://SIZNING_DOMENINGIZ/api/payments/click/prepare
#   https://SIZNING_DOMENINGIZ/api/payments/click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
